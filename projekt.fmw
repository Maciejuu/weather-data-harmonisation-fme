.25<closeparen>'NE'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>56.25<comma>78.75<closeparen>'ENE'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>78.75<comma>101.25<closeparen>'E'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>101.25<comma>123.75<closeparen>'ESE'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>123.75<comma>146.25<closeparen>'SE'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>146.25<comma>168.75<closeparen>'SSE'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>168.75<comma>191.25<closeparen>'S'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>191.25<comma>213.75<closeparen>'SSW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>213.75<comma>236.25<closeparen>'SW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>236.25<comma>258.75<closeparen>'WSW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>258.75<comma>281.25<closeparen>'W'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>281.25<comma>303.75<closeparen>'WNW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>303.75<comma>326.25<closeparen>'NW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>326.25<comma>348.75<closeparen>'NNW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>wind_dir<closeparen> RANGE <openparen>348.75<comma>360.0<closebracket>'N'FME_NUM_CONDITIONS18___" "char<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "wind_dir" "windDirD" "" "int32" "RENAME_SET_VALUE" }      ATTR_ACTION {