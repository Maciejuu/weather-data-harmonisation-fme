'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>78.75<comma>101.25<closeparen>'E'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>101.25<comma>123.75<closeparen>'ESE'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>123.75<comma>146.25<closeparen>'SE'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>146.25<comma>168.75<closeparen>'SSE'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>168.75<comma>191.25<closeparen>'S'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>191.25<comma>213.75<closeparen>'SSW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>213.75<comma>236.25<closeparen>'SW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>236.25<comma>258.75<closeparen>'WSW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>258.75<comma>281.25<closeparen>'W'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>281.25<comma>303.75<closeparen>'WNW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>303.75<comma>326.25<closeparen>'NW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>326.25<comma>348.75<closeparen>'NNW'BOOL_OP;OR;COMPOSITE_TEST;1;NUM_TEST <at>Value<openparen>windDirD<closeparen> RANGE <openparen>348.75<comma>360.0<closebracket>'N'FME_NUM_CONDITIONS18___" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "relativeHumidity" "humid" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>humid<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>humid<closeparen> < 0;TEST <at>Value<openparen>humid<closeparen> > 100'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real64" "RENAME_SET_VALUE" }      ATTR_ACTION { "precipitation" "rain1h" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>rain1h<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>rain1h<closeparen> > 0;TEST <at>Value<openparen>rain1h<closeparen> <= 100'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real64" "RENAME_SET_VALUE" }      ATTR_ACTION { "airPressure" "airPressure" "" "real64" "NO_OP" }      ATTR_ACTION { "dewPointTemperature" "dewPointTemperature" "" "real64" "NO_OP" }      ATTR_ACTION { "measurementDate" "datetime_utc" "" "buffer" "RENAME_SET_VALUE" }      ATTR_ACTION { "stationType" "stationType" "" "char<openparen>200<closeparen>" "NO_OP" }      ATTR_ACTION { "stationId" "stationId" "" "char<openparen>200<closeparen>" "NO_OP" }      ATTR_ACTION { "_timenow" "_timenow" "" "datetime" "NO_OP" }      ATTR_ACTION { "_result_datetime" "_result_datetime" "" "datetime" "NO_OP" }      ATTR_ACTION { "x" "x" "" "real64" "NO_OP" }      ATTR_ACTION { "y" "y" "" "real64" "NO_OP" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeManager_2_OUTPUT        }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeRemover_2 }    INPUT  FEATURE_TYPE AttributeManager_2_OUTPUT    OUTPUT { FEATURE_TYPE AttributeRemover_2_OUTPUT        @RemoveAttributes(fme_encoded,stationId,stationType,_timenow,_result_datetime,x,y)        $(AttributeRemover_2_LIST_FUNC)         }
# -------------------------------------------------------------------------
Tcl2 proc AttributeRounder_round {places} {    set attrNames [split {humid rain1h temp} { }];    set funcName {round};    set parmList {{EvaluateExpression} {ATTR_SET_EXPR}};    set hasAttr 0;    foreach attrName $attrNames {       set decodedAttrName [FME_DecodeText $attrName];       set attrValue [FME_GetAttribute $decodedAttrName];       set comment {"--- skip null or missing attribute names without warning ---"};       if {$attrValue == {} || [FME_IsAttributeNull $decodedAttrName]} {          continue;       };       set comment {"--- do not round if the value is a string. warn skip the attribute ---"};       if {[string is double $attrValue] == 0} {          FME_LogMessage fme_warn 917360 {AttributeRounder} $decodedAttrName $attrValue;          continue;       };       set hasAttr 1;       set funcAttr $attrName;       set comment {"--- handle WWJD encoded attribute name embedded quote escaping ---"};       if { [string first "<quote>" $attrName] != -1 }       {          set funcAttr [string map {"<quote>" "<backslash><quote>"} $attrName];          append funcAttr "<quote>";          set funcAttr "<quote>"$funcAttr;       };       set comment {"--- build a WWJD string of: @round|ceil|floor(@Value(attrName),places) ---"};       set funcCall [join [list "<at>" $funcName "<openparen><at>Value<openparen>" $funcAttr "<closeparen><comma>" $places "<closeparen>"] {}];       lappend parmList $attrName;       lappend parmList $funcCall;    };    if {$hasAttr > 0} {       lappend parmList {AttributeRounder};       eval FME_Execute $parmList;    }; }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { AttributeRounder }    INPUT  FEATURE_TYPE AttributeRemover_2_OUTPUT    TEST { "1" TYPE INT ENCODED }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { PASSED FEATURE_TYPE __toOutput__ }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeRounder_AttributeRounder }    INPUT FEATURE_TYPE __toOutput__    OUTPUT { FEATURE_TYPE AttributeRounder_OUTPUT         @Tcl2("AttributeRounder_round {1}")          }
