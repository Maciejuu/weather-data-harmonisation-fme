FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector_4 }    INPUT  FEATURE_TYPE DateTimeCalculator_5_OUTPUT    ENGINE { SOURCE "" DESTINATION "@EvaluateExpression(FDIV,STRING,$(coordSyst$encode),Reprojector_4)" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_4_REPROJECTED          }
