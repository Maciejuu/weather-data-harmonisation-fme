FACTORY_DEF {*} SortFactory    FACTORY_NAME { Sorter_5 }    INPUT  FEATURE_TYPE AttributeRounder_3_OUTPUT    SORT_ALPHA_AS_UTF8 { YES }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    SORT_BY { name NATURAL ASCENDING NON_VALUES_AFTER_VALUES }
