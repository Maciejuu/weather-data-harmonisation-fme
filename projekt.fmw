FACTORY_DEF {*} DateTimeConverterFactory    FACTORY_NAME { DateTimeConverter_10 }    DATETIME_ATTR { "measurementDate" }    IN_FORMAT { "" }    OUT_FORMAT { "%Y-%m-%d<space>%H:%M" }    REPAIR_INPUT { "YES" }    PASSTHROUGH { "YES" }    INPUT  FEATURE_TYPE DateTimeCalculator_4_OUTPUT    OUTPUT { OUTPUT FEATURE_TYPE DateTimeConverter_10_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector_3 }    INPUT  FEATURE_TYPE DateTimeConverter_10_OUTPUT    ENGINE { SOURCE "" DESTINATION "@EvaluateExpression(FDIV,STRING,$(coordSyst$encode),Reprojector_3)" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_3_REPROJECTED          }
# -------------------------------------------------------------------------
INCLUDE [    set supplyXFunc {};    if { {x} != {} }    {       set supplyXFunc {@Coordinate(REJECTABLE,x,"0",FLATTEN_AGGREGATE,YES)};    };    puts "MACRO CoordinateExtractor_3_SUPPLY_X ${supplyXFunc}"; ]
INCLUDE [    set supplyYFunc {};    if { {y} != {} }    {       set supplyYFunc {@Coordinate(REJECTABLE,y,"0",FLATTEN_AGGREGATE,NO)};    };    puts "MACRO CoordinateExtractor_3_SUPPLY_Y ${supplyYFunc}"; ]
INCLUDE [    set supplyZDefaultFunc {};    if { {} != {} }    {       set supplyZDefaultFunc {@EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING,"",,FLOAT)};    };    puts "MACRO CoordinateExtractor_3_SUPPLY_Z_DEFAULT ${supplyZDefaultFunc}"; ]
