FACTORY_DEF * TeeFactory   FACTORY_NAME "Tester_12 PASSED Splitter"   INPUT FEATURE_TYPE Tester_12_PASSED   OUTPUT FEATURE_TYPE Tester_12_PASSED_0_FTmnoJUBoYg=   OUTPUT FEATURE_TYPE Tester_12_PASSED_1_ZR5Nx5/SnbQ=
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester_13 }    INPUT  FEATURE_TYPE Tester_12_PASSED_0_FTmnoJUBoYg=    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,$(IMGWfilestype$encode),Tester_13)" != Shapefile ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_13_PASSED         }
