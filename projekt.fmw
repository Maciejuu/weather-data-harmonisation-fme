FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { AttributeManager }    INPUT  FEATURE_TYPE CoordinateSystemSetter_3_OUTPUT    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ACTION_COLUMN 4    DEF_VAL_COLUMN 2    NUM_OF_COLUMNS 5    MISSING_INPUT_ATTR_HANDLING RENAME_SET_VALUE REMOVE    ATTR_ACTION { "statId" "id" "" "uint32" "RENAME_SET_VALUE" }      ATTR_ACTION { "StationName" "name" "" "char<openparen>200<closeparen>" "RENAME_SET_VALUE" }      ATTR_ACTION { "ownerId" "ownerId" "IMGW" "char<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "lat" "lat" "<at>Value<openparen>x<closeparen>" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "lng" "lng" "<at>Value<openparen>y<closeparen>" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "temp" "temp" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>temp<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>temp<closeparen> < -40;TEST <at>Value<openparen>temp<closeparen> > 45'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real32" "SET_TO" }      ATTR_ACTION { "tempMax24h" "tempMax24h" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>tempMax24h<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>tempMax24h<closeparen> < -40;TEST <at>Value<openparen>tempMax24h<closeparen> > 45'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real32" "SET_TO" }      ATTR_ACTION { "tempMax12h" "tempMax12h" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>tempMax12h<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>tempMax12h<closeparen> < -40;TEST <at>Value<openparen>tempMax12h<closeparen> > 45'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real32" "SET_TO" }      ATTR_ACTION { "tempMin24h" "tempMin24h" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>tempMin24h<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>tempMin24h<closeparen> < -40;TEST <at>Value<openparen>tempMin24h<closeparen> > 45'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real32" "SET_TO" }      ATTR_ACTION { "tempMin12h" "tempMin12h" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>tempMin12h<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>tempMin12h<closeparen> < -40;TEST <at>Value<openparen>tempMin12h<closeparen> > 45'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real32" "SET_TO" }      ATTR_ACTION { "opad1h" "rain1h" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>rain1h<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>rain1h<closeparen> > 100;TEST <at>Value<openparen>rain1h<closeparen> < 0'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "wilgBezw" "humid" "FME_CONDITIONAL:DEFAULT_VALUE'<at>Value<openparen>humid<closeparen>'BOOL_OP;OR;COMPOSITE_TEST;1 OR 2;TEST <at>Value<openparen>humid<closeparen> < 0;TEST <at>Value<openparen>humid<closeparen> > 100'FME_NULL_VALUE'FME_NUM_CONDITIONS2___" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "predWiatru" "windSpeed" "<at>Value<openparen>windSpeed<closeparen>" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "predWiatruMax10min" "windSpeedMax10min" "<at>Value<openparen>windSpeedMax10min<closeparen>" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "predWiatruMax24h" "windSpeedMax24h" "<at>Value<openparen>windSpeedMax24h<closeparen>" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "kierWiatru" "windDir" "" "char<openparen>200<closeparen>" "RENAME_SET_VALUE" }      ATTR_ACTION { "windDirD" "windDirD" "FME_CONDITIONAL:DEFAULT_VALUE'FME_NULL_VALUE'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN N'0'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN NNE'22.5'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN NE'45'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN ENE'67.5'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN E'90'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN ESE'112.5'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN SE'135'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN SSE'157.5'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN S'180'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN SSW'202.5'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN SW'225'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN WSW'247.5'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN W'270'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN WNW'292.5'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN NW'315'BOOL_OP;OR;COMPOSITE_TEST;1;TEST <at>Value<openparen>windDir<closeparen> IN NNW'337.5'FME_NUM_CONDITIONS17___" "real32" "SET_TO" }      ATTR_ACTION { "opad10m" "rain10min" "" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "opad3h" "rain3h" "" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "opad6h" "rain6h" "" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "opad12h" "rain12h" "" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "opad24h" "rain24h" "" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "opad24RR" "rain24RR" "" "real32" "RENAME_SET_VALUE" }      ATTR_ACTION { "tempLastTime" "datetime_utc" "" "buffer" "RENAME_SET_VALUE" }      ATTR_ACTION { "opad1hLastTime" "opad1hLastTime" "" "real32" "NO_OP" }      ATTR_ACTION { "opad24RRLastTime" "opad24RRLastTime" "" "real32" "NO_OP" }      ATTR_ACTION { "statName" "statName" "" "char<openparen>200<closeparen>" "NO_OP" }      ATTR_ACTION { "opadSum" "opadSum" "" "real32" "NO_OP" }      ATTR_ACTION { "isModel" "isModel" "" "char<openparen>200<closeparen>" "NO_OP" }      ATTR_ACTION { "Typ" "Typ" "" "char<openparen>200<closeparen>" "NO_OP" }      ATTR_ACTION { "_timenow" "_timenow" "" "datetime" "NO_OP" }      ATTR_ACTION { "_result_datetime" "_result_datetime" "" "datetime" "NO_OP" }      ATTR_ACTION { "x" "x" "" "real64" "NO_OP" }      ATTR_ACTION { "y" "y" "" "real64" "NO_OP" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeManager_OUTPUT        }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO AttributeRemover_LIST_FUNC }    } else {        puts "MACRO AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeRemover }    INPUT  FEATURE_TYPE AttributeManager_OUTPUT    OUTPUT { FEATURE_TYPE AttributeRemover_OUTPUT        @RemoveAttributes(fme_encoded,isModel,statName,Typ,opad1hLastTime,_timenow,opad24RRLastTime,opadSum,_result_datetime,x,y)        $(AttributeRemover_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester_8 }    INPUT  FEATURE_TYPE AttributeRemover_OUTPUT    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>windSpeed<closeparen>,Tester_8)" >= 0 ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>windSpeed<closeparen>,Tester_8)" < 350 ENCODED }    BOOLEAN_OPERATOR { COMPOSITE }    COMPOSITE_TEST_EXPR { "1 AND 2" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_8_PASSED         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} SortFactory    FACTORY_NAME { Sorter_2 }    INPUT  FEATURE_TYPE Tester_8_PASSED    SORT_ALPHA_AS_UTF8 { YES }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    SORT_BY { name NATURAL ASCENDING NON_VALUES_AFTER_VALUES }    OUTPUT { SORTED FEATURE_TYPE Sorter_2_SORTED          }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Sorter_2 SORTED Splitter"   INPUT FEATURE_TYPE Sorter_2_SORTED   OUTPUT FEATURE_TYPE Sorter_2_SORTED_0_1PZquP6stT4=   OUTPUT FEATURE_TYPE Sorter_2_SORTED_1_0WKU46qqTpY=   OUTPUT FEATURE_TYPE Sorter_2_SORTED_2_TI1S6lqOiPc=
