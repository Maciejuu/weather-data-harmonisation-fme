FACTORY_DEF {*} TeeFactory    FACTORY_NAME { CoordinateSystemSetter_6 }    INPUT  FEATURE_TYPE CoordinateExtractor_4_OUTPUT    OUTPUT { FEATURE_TYPE CoordinateSystemSetter_6_OUTPUT         @CoordSys("@EvaluateExpression(FDIV,STRING,$(coordSyst$encode),CoordinateSystemSetter_6)")          }
